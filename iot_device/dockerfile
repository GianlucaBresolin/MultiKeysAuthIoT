FROM rust:1.91-slim

RUN apt-get update && apt-get install -y \
    qemu-system-arm \
    gcc-aarch64-linux-gnu \
    binutils-aarch64-linux-gnu \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add aarch64-unknown-none && \
    rustup component add rust-src

ARG KEYS
ARG SKEY
ARG KEY_COUNT
ARG IOT_UID
ARG P

ENV KEYS=${KEYS}
ENV SKEY=${SKEY}
ENV KEY_COUNT=${KEY_COUNT}
ENV IOT_UID=${IOT_UID}
ENV P=${P}

WORKDIR /app
COPY . .

RUN apt-get update && apt-get install -y \
    qemu-system-arm \
    gcc-aarch64-linux-gnu \
    binutils-aarch64-linux-gnu \
    build-essential \
    curl \
    iproute2 \
    tcpdump \
    && rm -rf /var/lib/apt/lists/*

COPY /entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["cargo", "run", "--release", "--target", "aarch64-unknown-none"]